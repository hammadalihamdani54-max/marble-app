<!DOCTYPE html><html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Marble App Updated</title>
<style>
body {
  font-family: Arial, sans-serif;
  margin: 20px;
  background: #f4f4f4;
}
.container {
  background: white;
  padding: 20px;
  border-radius: 10px;
  max-width: 800px;
  margin: auto;
}
input {
  width: 100%;
  padding: 8px;
  margin: 5px 0;
}
button {
  padding: 10px;
  width: 100%;
  background: #007bff;
  color: white;
  border: none;
  border-radius: 5px;
}
table {
  width: 100%;
  margin-top: 20px;
  border-collapse: collapse;
}
table, th, td {
  border: 1px solid #ccc;
}
th, td {
  padding: 10px;
  text-align: center;
}
</style>
</head>
<body><div class="container">
  <h2>Marble Invoice App</h2><label>Item Name</label> <input type="text" id="item" placeholder="Enter item name" />

<label>Length (ft)</label> <input type="number" id="length" />

<label>Width (ft)</label> <input type="number" id="width" />

<label>Quantity</label> <input type="number" id="qty" />

<label>Cost Price per sq ft</label> <input type="number" id="cost" />

<label>Selling Price per sq ft</label> <input type="number" id="sale" />

<button onclick="calculate()">Calculate</button>

  <table>
    <thead>
      <tr>
        <th>Item</th>
        <th>Area (sq ft)</th>
        <th>Total Area</th>
        <th>Cost</th>
        <th>Sale</th>
        <th>Profit</th>
      </tr>
    </thead>
    <tbody id="result"></tbody>
  </table>
</div><script>
function calculate() {
  let item = document.getElementById("item").value;
  let length = parseFloat(document.getElementById("length").value);
  let width = parseFloat(document.getElementById("width").value);
  let qty = parseFloat(document.getElementById("qty").value);
  let cost = parseFloat(document.getElementById("cost").value);
  let sale = parseFloat(document.getElementById("sale").value);

  if (length < 0 || width < 0 || qty < 0 || cost < 0 || sale < 0) {
    alert("Negative values are not allowed");
    return;
  }

  if (!item || isNaN(length) || isNaN(width) || isNaN(qty) || isNaN(cost) || isNaN(sale)) {
    alert("Please fill all fields correctly");
    return;
  }

  let area = length * width;
  let totalArea = area * qty;

  let costTotal = totalArea * cost;
  let saleTotal = totalArea * sale;
  let profit = saleTotal - costTotal;

  document.getElementById("result").innerHTML = `
    <tr>
      <td>${item}</td>
      <td>${area.toFixed(2)}</td>
      <td>${totalArea.toFixed(2)}</td>
      <td>${costTotal.toFixed(2)}</td>
      <td>${saleTotal.toFixed(2)}</td>
      <td>${profit.toFixed(2)}</td>
    </tr>
  `;
}
</script></body>
</html>
